# duyanblog.com — environment template
# Copy to .env and edit. Never commit the real .env.

# --- Required ---
# MySQL (production, Hostinger Business Node.js app — set via the platform env, never committed)
DATABASE_URL="mysql://user:password@127.0.0.1:3306/dbname"

# Canonical origin — baked into canonicals, OG tags, sitemap and RSS at build time.
# Must be set BEFORE `npm run build`.
NEXT_PUBLIC_SITE_URL="https://duyanblog.com"

# --- Runtime (set on the production process) ---
# NODE_ENV=production     # flips session cookies to Secure + arms the production guards
# PORT=3000               # optional, standalone server port (default 3000)

# --- Optional ---
# Email: set RESEND_API_KEY to enable real double-opt-in emails.
# Without it: console transport in dev, mail disabled (with a loud warning) in production.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Duyan Blog <noreply@duyanblog.com>"

# Reserved — not read by code yet (see src/lib/consent.ts / AFFILIATE_INTEGRATION.md)
# NEXT_PUBLIC_ANALYTICS_PROVIDER=""
# NEXT_PUBLIC_ADS_ENABLED=""

# Safety overrides — only true while deliberately running these in production
# ALLOW_DEMO_SEED="true"
# ALLOW_ADMIN_BOOTSTRAP="true"

# Indexing gate — fail-closed by default. Set ALLOW_INDEXING=true ONLY on the
# real production deployment; everywhere else (localhost, preview, Hostinger
# demo subdomain, unknown clones) robots.txt returns a full Disallow: / so
# fictional demo content can never be indexed as production editorial.
# Using a flag (not domain-suffix guessing) means a mis-parked domain cannot
# silently start leaking.
# ALLOW_INDEXING="true"