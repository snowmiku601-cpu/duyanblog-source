# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude/*
!.claude/CLAUDE.md
!.claude/agents/
!.claude/rules/
!.claude/skills/
!.claude/memory/
!.claude/playbooks/
!.claude/settings.json
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log

# review artifacts (screenshots, DOM dumps) — create, read, delete
/snapshot/*
!/snapshot/README.md

# scratch dir (evidence captures with dates, disposable)
/_scratch/

# Claude Code workspace configuration (local machine state, never shared)
# settings.local.json holds machine-specific permissions — do not commit it.
.claude/settings.local.json
.claude/tmp/
.claude/drafts/
.claude/archive/
.claude/worktrees/

# Skills directory
/skills/
# tooling artifacts (never committed)
/.playwright-mcp/
/.verify/
/duyanblog-source.zip

# operational temp: staging DB backup dumps + password scratch (never committed)
/.staging-*
/.staging-dbpass*
